{
  "version": "8.11.0",
  "objects": [
    {
      "id": "pig-top-streets",
      "type": "visualization",
      "attributes": {
        "title": "Top 10 Streets by Records (Pig Filtered Data)",
        "visState": {
          "title": "Top Streets",
          "type": "table",
          "params": {
            "perPage": 10,
            "showPartialRows": false,
            "showMeticsAtAllLevels": false,
            "sort": {
              "columnIndex": 1,
              "direction": "desc"
            },
            "showTotal": false,
            "totalFunc": "sum"
          },
          "aggs": [
            {
              "id": "1",
              "enabled": true,
              "type": "count",
              "schema": "metric",
              "params": {}
            },
            {
              "id": "2",
              "enabled": true,
              "type": "terms",
              "schema": "bucket",
              "params": {
                "field": "street.keyword",
                "size": 10,
                "order": "desc",
                "orderBy": "1"
              }
            },
            {
              "id": "3",
              "enabled": true,
              "type": "terms",
              "schema": "bucket",
              "params": {
                "field": "city",
                "size": 5,
                "order": "desc",
                "orderBy": "1"
              }
            }
          ]
        },
        "uiStateJSON": "{\"vis\":{\"params\":{\"sort\":{\"columnIndex\":2,\"direction\":\"desc\"}}}}",
        "description": "Top 10 calles con más registros en los datos filtrados por Pig",
        "version": 1,
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "waze-pig-metrics",
            "query": {
              "bool": {
                "must": [
                  {
                    "term": {
                      "phase": "filtering"
                    }
                  },
                  {
                    "exists": {
                      "field": "street"
                    }
                  }
                ]
              }
            },
            "filter": []
          }
        }
      }
    }
  ]
}
